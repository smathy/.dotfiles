#!/usr/bin/env zsh
vim=neovide
pipe=./.nvim.pipe
args=($@)

line_file() {
  local re=':[0-9]+$'
  REPLY=$1
  if [[ $REPLY =~ $re ]]; then
    local pos=${REPLY[(I)[:]]}
    local line="+${REPLY:$pos}"
    REPLY="$line ${REPLY:0:$(($pos-1))}"
  fi
}

send_alls() {
  for arg in $@; do
    line_file $arg
    nvim --server $pipe --remote-send "<ESC>:vs $REPLY<CR>" > /dev/null
  done
}

ensure_nvim() {
  if [[ ! -S $pipe ]]; then
    local arg=$1
    line_file $arg
    arg=${arg:+$REPLY}
    $vim $arg -- --listen $pipe
    [ $arg ] && shift args
    sleep 0.1
  fi
}

if [[ "$#" -eq 0 ]]; then
  ensure_nvim
  if [[ -f Session.vim ]]; then
    nvim --server $pipe --remote-send "<ESC>:source Session.vim<CR>" > /dev/null
  fi
elif [[ "${args[1]}" == "-" ]]; then
  nvim '+set buftype=nofile' -
else
  ensure_nvim $args[1]
  send_alls $args
  osascript -e 'tell application "neovide" to activate'
fi

# vim: ft=zsh
